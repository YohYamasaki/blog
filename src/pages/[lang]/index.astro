---
import PostListPage from "../../components/PostListPage.astro";
import { getLangParams, type Language } from "../../i18n/ui";
import {
  getPostPage,
  getPostPageCount,
  getPosts,
} from "../../utils/posts.ts";

export async function getStaticPaths() {
  return getLangParams();
}

const { lang } = Astro.params as { lang: Language };
const allPosts = await getPosts(lang);
const totalPages = getPostPageCount(allPosts.length);
const posts = getPostPage(allPosts, 1);
---

<PostListPage {lang} {posts} currentPage={1} {totalPages} />
